# GitHub account or organization that owns the GHCR image (lowercase only).
GHCR_OWNER=your-github-user

# Use latest for normal deployments or a commit SHA for a fixed version.
VIKUNJA_TAG=latest

# Public address of the VPS. Keep the trailing slash.
VIKUNJA_PUBLIC_URL=http://SERVER_IP:3456/
VIKUNJA_PORT=3456

# Generate with: openssl rand -hex 32
VIKUNJA_SERVICE_SECRET=replace-with-a-long-random-value
